# Copie para .env.production.local (ou configure no painel da Cloudflare → Build → Variables).
# Nenhum destes valores é segredo: todos vão para o código público do app.

# Contato de suporte exibido no app (WhatsApp, e-mail ou página)
VITE_SUPPORT_URL=

# Ativação comercial (ver COMMERCIAL_ACTIVATION.md). Deixe vazio para NÃO exigir ativação.
VITE_ACTIVATION_MODE=
# Chave PÚBLICA (keys/public.jwk.json). NUNCA coloque a chave privada aqui.
VITE_ACTIVATION_PUBLIC_JWK=
# Opcional; padrão /api/activate
VITE_ACTIVATION_ENDPOINT=
